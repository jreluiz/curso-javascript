---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 20px
    lineColor: "#a88c00"
    primaryColor: "#fdf9e3"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#c9a800"
    edgeLabelBackground: "#fdfdfb"
  flowchart:
    nodeSpacing: 26
    rankSpacing: 50
    padding: 14
    wrappingWidth: 600
---
flowchart LR
    R["REST<br/>na definição"] ~~~ R1["somarTudo(1, 2, 3)"] -- "junta" --> R2["numeros = [1, 2, 3]"]
    S["SPREAD<br/>no uso"] ~~~ S1["Math.max(...[10, 5, 8])"] -- "espalha" --> S2["Math.max(10, 5, 8)"]

    classDef nome fill:#c9a800,stroke:#c9a800,stroke-width:3px,color:#1a1a1a,font-family:Menlo
    classDef valor fill:#fdf9e3,stroke:#c9a800,stroke-width:3px,color:#1a1a1a,font-family:Menlo
    classDef forte fill:#fdf9e3,stroke:#a88c00,stroke-width:5px,color:#1a1a1a,font-family:Menlo
    classDef texto fill:none,stroke:none,color:#1a1a1a
    classDef term fill:#1e1e1e,stroke:#1e1e1e,stroke-width:3px,color:#e6e6e6,font-family:Menlo
    classDef erro fill:#fbeae7,stroke:#b02a1c,stroke-width:3px,color:#1a1a1a,font-family:Menlo
    classDef tag fill:#c9a800,stroke:#c9a800,stroke-width:3px,color:#1a1a1a
    class R,S tag
    class R1,S1 valor
    class R2,S2 forte
    linkStyle 1,3 stroke:#a88c00,stroke-width:3px
